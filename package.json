{
  "name": "tarotpro",
  "version": "1.0.0",
  "description": "A borderless transparent tarot fortune widget for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable --x64"
  },
  "author": "n0t1ucky",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.n0t1ucky.tarotpro",
    "productName": "TarotPro",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "settings-preload.js",
      "renderer.js",
      "settings.js",
      "settings.html",
      "settings.css",
      "index.html",
      "styles.css",
      "compact.css",
      "toast.css",
      "toast.js",
      "assets/**/*",
      "theme/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}.exe"
    }
  }
}
